# Copy to .env and fill in
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Shared token for the staff dashboard (/admin) — change this
ADMIN_TOKEN=change-me

# Comma-separated origins allowed to call the API (hotel websites embedding the widget)
CORS_ORIGINS=*

# Local dev outside Docker
DATABASE_URL=postgresql+psycopg://hotel:hotel@localhost:5432/hotel

# ── Email notifications (optional) ───────────────────────────────────────────
# Leave SMTP_HOST empty to disable all email (safe for dev/demo).
#
# Gmail: use an App Password (myaccount.google.com → Security → App passwords)
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_TLS=true
#
# Outlook / Office 365:
#   SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_TLS=true
#
# Zoho Mail:
#   SMTP_HOST=smtp.zoho.com  SMTP_PORT=587  SMTP_TLS=true
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
EMAIL_FROM=
EMAIL_FROM_NAME=Hotel Concierge
STAFF_EMAIL=         # staff alert destination for new bookings
EMAIL_ENABLED=true
