# Backend API base URL (used by Next.js rewrites on the server)
API_URL=http://localhost:8000

# Same URL exposed to the browser (for client-side SSE streaming)
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here

# Google OAuth — create credentials at console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin — must match ADMIN_TOKEN in backend .env
ADMIN_TOKEN=change-me

# Comma-separated admin emails (defaults to primeshmarasingha@gmail.com)
# ADMIN_EMAILS=primeshmarasingha@gmail.com

# URL of the full Vite admin panel (defaults to localhost:5173 for dev)
# NEXT_PUBLIC_ADMIN_PANEL_URL=http://localhost:5173
